"use strict";
var pushNotification = function(posTop, posRight, title, description, type) {
    var notifMessage = document.createElement("div");
    var notifTitle = document.createElement("h2");
    var notifDescription = document.createElement("p");
    notifMessage.classList.add("notification", type);
    notifTitle.classList.add("title");
    notifTitle.textContent = title;
    notifDescription.textContent = description;
    notifMessage.append(notifTitle, notifDescription);
    notifMessage.style.top = "".concat(posTop, "px");
    notifMessage.style.right = "".concat(posRight, "px");
    document.body.appendChild(notifMessage);
    setTimeout(function() {
        notifMessage.style.visibility = "hidden";
    }, 2000);
};
pushNotification(10, 10, "Title of Success message", "Message example.\n Notification should contain title and description.", "success");
pushNotification(150, 10, "Title of Error message", "Message example.\n Notification should contain title and description.", "error");
pushNotification(290, 10, "Title of Warning message", "Message example.\n Notification should contain title and description.", "warning");

